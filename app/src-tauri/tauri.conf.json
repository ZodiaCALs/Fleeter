{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fleeter",
  "version": "1.0.0",
  "identifier": "app.fleeter.reader",
  "build": {
    "frontendDist": "../../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fleeter",
        "width": 1240,
        "height": 900,
        "minWidth": 380,
        "minHeight": 560,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "News",
    "shortDescription": "Your morning briefing",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}